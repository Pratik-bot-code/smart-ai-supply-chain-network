# Smart AI Supply Chain Network - Environment Configuration
APP_NAME="Smart AI Supply Chain Network"
APP_ENV="development"
PORT=8000
HOST="0.0.0.0"

# Database Configuration (SQLite by default, MySQL option)
DATABASE_TYPE="sqlite"
SQLITE_DB_PATH="supply_chain.db"
# MYSQL_URL="mysql+pymysql://user:password@localhost:3306/supplychain"

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# AI Agent Configuration
DEMO_DATA_MODE=true
AUTO_APPROVAL_THRESHOLD=0.98
MIN_HISTORICAL_DAYS_FOR_FORECAST=14
